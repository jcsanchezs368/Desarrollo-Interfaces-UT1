<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ControlAlmacen.Views.HomeView">
    <UserControl.Background>
        <ImageBrush Stretch="Fill" Source="avares://ControlAlmacen/Assets/ErciGambas-3.png"></ImageBrush>
        
    </UserControl.Background>
    
   <!-- <Image Stretch="Fill" anim:ImageBehavior.AnimatedSource="avares://ControlAlmacen/Assets/hackerman.gif" /> -->
</UserControl>
