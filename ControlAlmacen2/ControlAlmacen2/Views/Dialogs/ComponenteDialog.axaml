<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:ControlAlmacen2.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             Width="500" Height="800"
             x:DataType="viewmodel:ConsultasViewModel"
             x:Class="ControlAlmacen2.Views.Dialogs.ComponenteDialog">

    <StackPanel>
        <TextBlock Text="EDITAR COMPONENTE"></TextBlock>
        <TextBox Text="{Binding SelectedComponente.Id}" />
        <TextBox Text="{Binding SelectedComponente.Codigo}" />
        <TextBox Text="{Binding SelectedComponente.Nombre}" />
        <TextBox Text="{Binding SelectedComponente.Descripcion}" />
        <TextBox Text="{Binding SelectedComponente.Activo}" />
        <TextBox Text="{Binding SelectedComponente.Stock}" />
        <TextBox Text="{Binding SelectedComponente.PrecioVenta}" />
        <Button Content="EDITAR" Command="{Binding EditarComponenteCommand}"></Button>
        
    </StackPanel>
    
</UserControl>